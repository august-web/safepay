# SikaVoice — Track 1 (Companion App) environment template
# Copy to .env and fill in values when the backend is wired up.
# Nothing here is required for the current mock-data demo.

# === Appwrite Backend (dev brief §4.3) ===
APWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APWRITE_PROJECT_ID=your_project_id
APWRITE_API_KEY=your_api_key

# === Arkesel VoiceConnect (Track 2 Voice Line, dev brief §4.3) ===
ARKESEL_API_KEY=your_arkesel_key
ARKESEL_ACCOUNT_SID=your_arkesel_sid
ARKESEL_TOLL_FREE_NUMBER=+233XXXXXXXXX

# === Mobobi Abena AI (spoken passphrase auth, dev brief §4.3) ===
ABENA_API_KEY=your_abena_key
ABENA_API_SECRET=your_abena_secret

# === Voice Line runtime (see voice-line/README.md) ===
# Mock mode is the default (no credentials needed); set to false for live Arkesel.
MOCK_VOICE_LINE=true
MOCK_PIN=0000
PUBLIC_BASE_URL=http://localhost:3000

# === MTN MoMo API (sandbox for development) ===
MOMO_API_KEY=your_momo_key
MOMO_API_SECRET=your_momo_secret
MOMO_SUBSCRIPTION_KEY=your_subscription_key
MOMO_ENVIRONMENT=sandbox

# === UG HCI Lab Speech APIs (ASR/TTS — Phase II screening requirement) ===
# Copy the key from the HCI Lab dashboard into .env (NEVER commit it).
# Quotas: 10 ASR + 15 TTS requests/day, 5/min each. The app tracks both locally
# (safepay.asrUsage / safepay.ttsUsage) so Settings can warn before a demo, and
# a 429 on either is surfaced as a graceful fallback.
EXPO_PUBLIC_SPEECH_API_KEY=your_hci_lab_key
EXPO_PUBLIC_SPEECH_API_BASE_URL=your_hci_lab_base_url

# Optional second Lab subscription. If the primary returns a recoverable
# failure (429 / 401 / 5xx / timeout) and an ALT pair is configured below, the
# app retries the call on the alternate endpoint once — no new dependency.
# Leave both blank to disable.
EXPO_PUBLIC_SPEECH_API_KEY_ALT=
EXPO_PUBLIC_SPEECH_API_BASE_URL_ALT=

# Language codes: tw, ee, ga (lab code `gaa`), en. The lab has no Pidgin model,
# so `pcm` is sent as `en` (English pronunciation of Pidgin text).

# === App Config ===
APP_NAME=SikaVoice
DEFAULT_LANGUAGE=tw
