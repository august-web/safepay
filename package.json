{
  "name": "sikavoice",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "apk": "bash scripts/build-android-apk.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx",
    "a11y:contrast": "node scripts/wcag-audit.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "voice-clips": ".tools/tts-venv/bin/python scripts/generate-voice-clips.py",
    "icons:preview": "python3 scripts/generate-icons.py --preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-audio": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-local-authentication": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^57.0.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
